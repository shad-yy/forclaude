# Smart Live TV - Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Required — admin authentication (use a strong secret in production)
JWT_SECRET=<REDACTED>

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# hCaptcha (GDPR-compliant CAPTCHA)
# Get free sitekey at hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# TheSportsDB API key; free tier uses 123 (30 req/min). Set for higher limits.
THESPORTSDB_API_KEY=123

# NewsData.io API key for sports news (free tier: 200 req/day). Omit to use mock news.
NEWS_API_KEY=<REDACTED>

# Social media URLs (optional — leave blank to hide icons)
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Optional overrides
# NEXT_PUBLIC_STORE_URL=https://yourstore.com
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_THESPORTSDB_API_BASE_URL=
# NEXT_PUBLIC_NEWSDATA_API_BASE_URL=
# NEXT_PUBLIC_UFC_API_BASE_URL=
# ADMIN_PASSWORD=  (or ADMIN_PASSWORD_HASH for dev dashboard)

# Resend API for Order notifications
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# Upstash Redis (required for Vercel deployment)
# Get free credentials at upstash.com → create Redis DB → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
